{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import re\n","from collections import Counter\n","df = pd.read_csv( \"raw_data.csv\")"],"metadata":{"id":"Ep7zyfioenVo","executionInfo":{"status":"ok","timestamp":1792804408009,"user_tz":300,"elapsed":26,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["df[\"major\"] = df[\"Interested Majors\"].str.strip()\n","\n","\n","TYPO_FIX = {\n","    \"ap staitsics\": \"ap statistics\",\n","    \"ap world histoiry\": \"ap world history\",\n","    \"ap physics c mechanic\": \"ap physics c mechanics\",\n","    \"ap chinese literature and language\": \"ap chinese language and literature\",\n","}"],"metadata":{"id":"zQL0IDoNoIlH","executionInfo":{"status":"ok","timestamp":1792804408023,"user_tz":300,"elapsed":11,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["def parse_courses(text):\n","    if pd.isna(text):\n","        return []\n","    text = re.sub(r\"\\(\\d\\)|\\s\\d\\b\", \"\", text)\n","    parts = re.split(r\"(?=\\bA[Pp]\\s)\", text)\n","    courses = []\n","    for p in parts:\n","        key = \" \".join(p.lower().split())\n","        key = TYPO_FIX.get(key, key)\n","        if key.startswith(\"ap \") and len(key) > 3:\n","            courses.append(key)\n","    return courses"],"metadata":{"id":"2aNdLV-apNXc","executionInfo":{"status":"ok","timestamp":1792804408066,"user_tz":300,"elapsed":40,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["df[\"courses\"] = (df[\"AP Courses for 10th grade\"].apply(parse_courses)\n","                 + df[\"AP Courses for 11th grade\"].apply(parse_courses)).apply(set)\n","\n","display_name = {}\n","for col in [\"AP Courses for 10th grade\", \"AP Courses for 11th grade\"]:\n","    for text in df[col].dropna():\n","        for p in re.split(r\"(?=\\bA[Pp]\\s)\", re.sub(r\"\\(\\d\\)\", \"\", text)):\n","            p = \" \".join(p.split())\n","            display_name.setdefault(\" \".join(p.lower().split()), p)"],"metadata":{"id":"SVKr9jGxqvbP","executionInfo":{"status":"ok","timestamp":1792804408089,"user_tz":300,"elapsed":22,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["MIN_STUDENTS = 20\n","TOP_N = 5\n","\n","recommendations = {}\n","for major, group in df.groupby(\"major\"):\n","    if len(group) < MIN_STUDENTS:\n","        continue\n","    counts = Counter(c for courses in group[\"courses\"] for c in courses)\n","    recommendations[major] = [\n","        {\"course\": display_name.get(c, c),\n","         \"percent\": round(n / len(group) * 100, 1)}\n","        for c, n in counts.most_common(TOP_N)\n","    ]\n","\n","\n"],"metadata":{"id":"cT2dgqWWsPWG","executionInfo":{"status":"ok","timestamp":1792804408140,"user_tz":300,"elapsed":44,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["for m, recs in recommendations.items():\n","    print(m, [r[\"course\"] for r in recs])\n","\n","\n","from fastapi import FastAPI, HTTPException\n","from fastapi.middleware.cors import CORSMiddleware\n","from pydantic import BaseModel\n","\n","app = FastAPI()\n","app.add_middleware(CORSMiddleware, allow_origins=[\"*\"], allow_methods=[\"*\"], allow_headers=[\"*\"])\n","\n","def get_recommendation(major):\n","    if major not in recommendations:\n","        raise HTTPException(status_code=404, detail=f\"Unknown major: {major}\")\n","    return {\"major\": major, \"recommendations\": recommendations[major]}\n"],"metadata":{"id":"LBzRs1VJuwGR","executionInfo":{"status":"ok","timestamp":1792804408795,"user_tz":300,"elapsed":656,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"2a707661-a19d-4e7c-f4ea-87d820da127c"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Art ['AP Art History', 'AP Calculus BC', 'AP Music Theory', 'AP Calculus AB', 'AP Microeconomics']\n","Biology ['AP Biology', 'AP Chemistry', 'AP Environmental Science', 'AP Calculus BC', 'AP Statistics']\n","Chemistry ['AP Chemistry', 'AP Biology', 'AP Calculus BC', 'AP Environmental Science', 'AP Microeconomics']\n","Computer Science ['AP Computer Science A', 'AP Calculus BC', 'AP Microeconomics', 'AP Statistics', 'AP Computer Science Principles']\n","Economics ['AP Microeconomics', 'AP Macroeconomics', 'AP Calculus BC', 'AP Calculus AB', 'AP Physics C Mechanics']\n","Engineering ['AP Calculus BC', 'AP Physics C Mechanics', 'AP Computer Science A', 'AP Microeconomics', 'AP Statistics']\n","History ['AP American History', 'AP World History', 'AP Calculus BC', 'AP Seminar', 'AP English Language and Composition']\n","Literature ['AP American History', 'AP English Language and Composition', 'AP Calculus BC', 'AP World History', 'AP Seminar']\n","Math ['AP Calculus BC', 'AP Calculus AB', 'AP Computer Science A', 'AP Microeconomics', 'AP Statistics']\n","Music ['AP Music Theory', 'AP Calculus BC', 'AP Art History', 'AP Psychology', 'AP Seminar']\n","Physics ['AP Calculus BC', 'AP Physics C Mechanics', 'AP Microeconomics', 'AP Physics C Electricity and Magnetism', 'AP Computer Science A']\n","Psychology ['AP Psychology', 'AP Macroeconomics', 'AP Calculus BC', 'AP Statistics', 'AP Microeconomics']\n","Social Science ['AP Calculus BC', 'AP Microeconomics', 'AP Physics C Mechanics', 'AP Macroeconomics', 'AP Psychology']\n"]}]},{"cell_type":"code","source":["@app.get(\"/majors\")\n","def majors():\n","    return list(recommendations.keys())\n","\n","@app.get(\"/recommend\")\n","def recommend_get(major: str):\n","    return get_recommendation(major)\n","\n","class MajorInput(BaseModel):\n","    major: str\n","\n","@app.post(\"/recommend\")\n","def recommend_post(data: MajorInput):\n","    return get_recommendation(data.major)\n"],"metadata":{"id":"6-SuQ5ERvSeN","executionInfo":{"status":"ok","timestamp":1792804408857,"user_tz":300,"elapsed":60,"user":{"displayName":"Minseo Kim","userId":"18289107561063497017"}}},"execution_count":12,"outputs":[]}]}